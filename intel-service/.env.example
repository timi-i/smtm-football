# ===== LLM (OpenAI 兼容接口,支持 OpenAI / DeepSeek / 通义 / Moonshot 等) =====
LLM_API_KEY=你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ===== 主项目数据目录 =====
# PREDICTIONS_PATH=/app/daily-football-predictor/data/predictions.json
# ADJUSTMENTS_PATH=/app/daily-football-predictor/data/adjustments.json

# ===== 情报服务配置 =====
NEWS_LANGUAGE=zh-CN
NEWS_PER_MATCH=8
NEWS_MAX_MATCHES=20
NEWS_TIMEOUT=15

# ===== 网络代理（香港服务器访问中国网站需要）=====
# 请根据实际情况修改代理地址和端口
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1

# ===== 开关 =====
ENABLE_NEWS=true
ENABLE_LLM=true
WRITE_OUTPUT=true
VERBOSE=false
