# ===== LLM (OpenAI 兼容接口,支持 OpenAI / DeepSeek / 通义 / Moonshot 等) =====
LLM_API_KEY=你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ===== 情报服务配置 =====
NEWS_LANGUAGE=zh-CN
NEWS_PER_MATCH=8
NEWS_MAX_MATCHES=20
NEWS_TIMEOUT=15

# ===== 开关 =====
ENABLE_NEWS=true
ENABLE_LLM=true
WRITE_OUTPUT=true
VERBOSE=false
