# ===== LLM (OpenAI 兼容接口,支持 OpenAI / DeepSeek / 通义 / Moonshot 等) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ===== 主项目数据目录 =====
# PREDICTIONS_PATH=/path/to/daily-football-predictor/data/predictions.json
# ADJUSTMENTS_PATH=/path/to/daily-football-predictor/data/adjustments.json

# ===== 新闻抓取 =====
NEWS_LANGUAGE=zh-CN
NEWS_PER_MATCH=8
NEWS_MAX_MATCHES=20
NEWS_TIMEOUT=15

# ===== 开关 =====
ENABLE_NEWS=true
ENABLE_LLM=true
WRITE_OUTPUT=true
VERBOSE=false
